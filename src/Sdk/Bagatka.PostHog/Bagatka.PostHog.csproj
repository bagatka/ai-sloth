<Project Sdk="Microsoft.NET.Sdk">

  <!-- Written to be published on NuGet unchanged: a PostHog client for any .NET app, Native AOT
       included, in the shape of PostHog's own SDKs. Nothing here knows AiSloth. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Bagatka.PostHog</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <Authors>Aleksandr Bagatka</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>A PostHog client for .NET that works with Native AOT and trimming: product analytics events, identify and group identify, and exceptions for error tracking, sent in the background in bounded batches. No dependencies beyond .NET.</Description>
    <PackageTags>posthog;analytics;error-tracking;aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/bagatka/ai-sloth</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every public symbol is listed in PublicAPI.*.txt, so a change to the public surface is a deliberate edit. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
