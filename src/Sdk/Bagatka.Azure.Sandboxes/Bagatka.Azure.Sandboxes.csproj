<Project Sdk="Microsoft.NET.Sdk">

  <!-- Written to be published on NuGet unchanged: a client for Azure Container Apps Sandboxes in the
       Azure SDK's own style, for any .NET app. Nothing here knows AiSloth. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Bagatka.Azure.Sandboxes</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <Authors>Aleksandr Bagatka</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>A .NET client for Azure Container Apps Sandboxes: create, stop, resume, and delete sandboxes, commit them to disk images, and turn container images into disk images. Built on Azure.Core, with OpenTelemetry traces and metrics.</Description>
    <PackageTags>azure;container-apps;sandboxes;microvm;agents</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/bagatka/ai-sloth</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" />
    <!-- Every public symbol is listed in PublicAPI.*.txt, so a change to the public surface is a deliberate edit. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
