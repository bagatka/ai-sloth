<Project Sdk="Microsoft.NET.Sdk">

  <!-- C# for both sides is generated from daemon.proto at build time; never hand-edit it. -->
  <ItemGroup>
    <Protobuf Include="daemon.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

</Project>
