<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Published as a single Native AOT binary, installed as sloth; the trimming and AOT analyzers
         run on every build. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Every restore includes these, so a publish for any one can skip restoring and the lock file
         stays the same. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(SlothReleases)' != ''">
    <!-- A release names the GitHub repository whose releases it updates from (CLI / Release sets it,
         with the version); built from source, sloth has none. -->
    <AssemblyMetadata Include="SlothReleases" Value="$(SlothReleases)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The end-to-end tests run sloth's commands and machine mode in their own process. -->
    <InternalsVisibleTo Include="Bagatka.AiSloth.EndToEndTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bagatka.AiSloth.MachineProtocol\Bagatka.AiSloth.MachineProtocol.csproj" />
    <ProjectReference Include="..\..\Sandboxing\Bagatka.Sandboxing.Docker\Bagatka.Sandboxing.Docker.csproj" />
    <ProjectReference Include="..\..\Sdk\Bagatka.PostHog\Bagatka.PostHog.csproj" />
  </ItemGroup>

</Project>
