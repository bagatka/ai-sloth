<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Its image is published ahead-of-time compiled for its architecture, which starts it about a
         third faster on a third less CPU than compiling everything on first use. Every restore
         includes both, so the image's publish can skip restoring and the lock file stays the same. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- For `dotnet ef migrations add`; never part of the published app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The API's description for review and clients (HostJourney checks it); the host serves its own. -->
    <Content Remove="openapi.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Aspire\Bagatka.ServiceDefaults\Bagatka.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Cli\Bagatka.AiSloth.MachineProtocol\Bagatka.AiSloth.MachineProtocol.csproj" />
    <ProjectReference Include="..\..\Daemon\Bagatka.AiSloth.DaemonProtocol\Bagatka.AiSloth.DaemonProtocol.csproj" />
    <ProjectReference Include="..\..\Foundation\Bagatka.Foundation.Web\Bagatka.Foundation.Web.csproj" />
    <ProjectReference Include="..\..\Sandboxing\Bagatka.Sandboxing.Azure\Bagatka.Sandboxing.Azure.csproj" />
    <ProjectReference Include="..\..\Sandboxing\Bagatka.Sandboxing.Docker\Bagatka.Sandboxing.Docker.csproj" />
    <ProjectReference Include="..\..\Storage\Bagatka.ObjectStorage\Bagatka.ObjectStorage.csproj" />
    <ProjectReference Include="..\..\Storage\Bagatka.ObjectStorage.AzureBlob\Bagatka.ObjectStorage.AzureBlob.csproj" />
    <ProjectReference Include="..\Modules\AgentAccounts\Bagatka.AiSloth.AgentAccounts\Bagatka.AiSloth.AgentAccounts.csproj" />
    <ProjectReference Include="..\Modules\Secrets\Bagatka.AiSloth.Secrets\Bagatka.AiSloth.Secrets.csproj" />
    <ProjectReference Include="..\Modules\Sources\Bagatka.AiSloth.Sources\Bagatka.AiSloth.Sources.csproj" />
    <ProjectReference Include="..\Modules\Chats\Bagatka.AiSloth.Chats\Bagatka.AiSloth.Chats.csproj" />
    <ProjectReference Include="..\Modules\Machines\Bagatka.AiSloth.Machines\Bagatka.AiSloth.Machines.csproj" />
    <ProjectReference Include="..\Modules\Nooks\Bagatka.AiSloth.Nooks\Bagatka.AiSloth.Nooks.csproj" />
    <ProjectReference Include="..\Modules\Users\Bagatka.AiSloth.Users\Bagatka.AiSloth.Users.csproj" />
    <ProjectReference Include="..\Modules\Workspaces\Bagatka.AiSloth.Workspaces\Bagatka.AiSloth.Workspaces.csproj" />
  </ItemGroup>

</Project>
