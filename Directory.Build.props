<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- MSBuild and NuGet warnings fail local builds the same way they fail CI. -->
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>11.0</AnalysisLevel>
    <!-- Every rule is on; the few that conflict with this codebase are turned off in .editorconfig with a reason. -->
    <AnalysisMode>All</AnalysisMode>
    <!-- Keep style rules opt-in via .editorconfig instead of enabling every style preference. -->
    <AnalysisModeStyle>Default</AnalysisModeStyle>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 (unnecessary usings) in builds; also makes CS1591 demand docs on public API. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!-- Our own analyzer: the code-shape rules no off-the-shelf analyzer covers (PATTERNS.md, entry 26).
       The Aspire app host would otherwise take the reference for a service to run. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Bagatka.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analyzers/Bagatka.Analyzers/Bagatka.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)LoggerParameterTypes.txt" />
  </ItemGroup>
</Project>
