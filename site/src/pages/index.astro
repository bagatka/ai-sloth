---
// The landing page. Its words are the product's: only what AiSloth does today, or says is coming.
const repository = "https://github.com/bagatka/ai-sloth-dotnet";
const download = `${repository}/releases/latest`;

// A real session, replayed once on arrival at about the pace it ran (milliseconds after load).
const session = [
  { at: 0, parts: [["prompt", "$ "], ["", 'sloth chat "Create hello.txt containing the word hi, then reply with just: done" --harness codex']] },
  { at: 700, parts: [["dim", "Chat ac97fd · Codex · OpenRouter · laptop"]] },
  { at: 950, parts: [["you", "› You: "], ["", "Create hello.txt containing the word hi, then reply with just: done"]] },
  { at: 1700, parts: [["", "I’ll create hello.txt with the word hi."]] },
  { at: 2200, parts: [["dim", "  ▸ printf 'hi' > hello.txt"]] },
  { at: 3000, parts: [["", "done"]] },
  { at: 3250, parts: [["dim", "── done · 5s ──"]] },
  { at: 3450, parts: [["dim", "  (files saved as checkpoint 1)"]] },
];

const places = [
  {
    title: "In our cloud",
    text: "Each nook is a small virtual machine of its own. Nothing to install or keep running on your side.",
  },
  {
    title: "On your own computer",
    text: "Connect a Linux computer, or Windows through WSL, with <code>sloth machine connect</code>. Your agents run on your hardware, and you follow them from anywhere while it’s online.",
  },
  {
    title: "On your own server",
    text: "Run all of AiSloth on a server or inside your company’s network. A packaged setup is on its way.",
  },
];

const facts = [
  {
    title: "Ready copies",
    text: "Once a repository’s setup has run, new nooks start from a copy with it done. The agent acts within seconds of your message.",
  },
  {
    title: "Sleep and wake",
    text: "Nooks nobody uses go to sleep and wake in a few seconds, with their files and an agent that remembers the conversation.",
  },
  {
    title: "A checkpoint every turn",
    text: "The files are saved after each turn. A lost sandbox comes back where it was, and any checkpoint can start a new chat.",
  },
  {
    title: "Docker inside",
    text: "Every nook runs its own Docker, so compose files, Testcontainers and image builds work as they do on your laptop.",
  },
];

const accounts = [
  "A GitHub Copilot plan",
  "An OpenAI or Anthropic API key",
  "A key from any compatible provider, such as OpenRouter",
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>AiSloth</title>
    <meta name="description" content="AiSloth runs Claude Code, Codex, pi and GitHub Copilot in sandboxes of their own that start in seconds and keep working while you're away." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/recursive-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#edf0e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1612" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <div class="page">
      <header class="top">
        <a class="wordmark" href="/">AiSloth</a>
        <nav aria-label="Elsewhere">
          <a href={repository}>GitHub</a>
          <a href={download}>Download sloth</a>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="promise">
          <div class="pitch">
            <h1 id="promise">Your coding agents keep going when you close the laptop.</h1>
            <p>AiSloth runs Claude Code, Codex, pi and GitHub Copilot in nooks: sandboxes of their own that start in seconds, save their work after every turn, and wait for you wherever you pick it up.</p>
            <div class="actions">
              <a class="button primary" href={download}>Download sloth</a>
              <a class="button secondary" href={repository}>Read the code</a>
            </div>
          </div>
          <figure class="terminal" aria-label="A chat started with sloth, the AiSloth command line">
            <div class="session" data-replay>
              {session.map((line) => (
                <div class="line" data-at={line.at}>
                  {line.parts.map(([kind, text]) => (kind ? <span class={kind}>{text}</span> : text))}
                </div>
              ))}
              <div class="line" data-at="3700"><span class="prompt">$ </span><span class="cursor" aria-hidden="true"></span></div>
            </div>
          </figure>
        </section>

        <section aria-labelledby="where">
          <h2 id="where">Run your agents where it suits you</h2>
          <p class="lead">Each chat gets a nook of its own. Pick where it runs; the chat works the same everywhere.</p>
          <ul class="places">
            {places.map((place) => (
              <li>
                <h3>{place.title}</h3>
                <p set:html={place.text} />
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="fast">
          <h2 id="fast">Built to start fast and stay put</h2>
          <p class="lead">Waiting for a sandbox to boot and install your dependencies is the slow part of cloud agents. Nooks skip it.</p>
          <div class="facts">
            {facts.map((fact) => (
              <div>
                <h3>{fact.title}</h3>
                <p>{fact.text}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="accounts" aria-labelledby="accounts">
          <div>
            <h2 id="accounts">Your agents, your accounts</h2>
            <p>Use the plan you already pay for, or an API key. A workspace can share accounts and secrets with everyone in it, and each person can keep their own.</p>
          </div>
          <ul>
            {accounts.map((account) => <li>{account}</li>)}
          </ul>
        </section>
      </main>

      <footer>
        <p>Web and phone apps that connect to any AiSloth host are next. Until then, <code>sloth</code> does everything from your terminal.</p>
        <nav aria-label="Project">
          <a href={repository}>GitHub</a>
          <a href={`${repository}/releases`}>Releases</a>
        </nav>
      </footer>
    </div>

    <script>
      // Replays the session once, each line at the moment it came. The lines are already on the page,
      // so without this script, or with reduced motion, it shows whole.
      const lines = document.querySelectorAll<HTMLElement>("[data-replay] .line");
      const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!still) {
        for (const line of lines) {
          line.classList.add("waiting");
          window.setTimeout(() => line.classList.remove("waiting"), Number(line.dataset.at));
        }
      }
    </script>
  </body>
</html>

<style is:global>
  /* Layout: a left-aligned page; the hero pairs the promise with a real sloth session, and the rest
     reads as short lists. One family, Recursive, in three voices: casual and heavy for display, linear
     for reading, mono for anything typed. The ground is lichen and bark; a sloth's fur grows algae,
     hence the moss accent, the page's only color. */
  @font-face {
    font-family: "Recursive";
    src: url("/fonts/recursive-latin.woff2") format("woff2");
    font-weight: 300 1000;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  :root {
    --lichen: #edf0e6;
    --bark: #26211b;
    --fur: #665f53;
    --moss: #477a2c;
    --rule: #d2d6c6;
    --on-moss: #f6f4ec;
    --term-bg: #2b241c;
    --term-fg: #efe7d8;
    --term-dim: #a99d88;
    --term-moss: #b9d39a;
    --font: "Recursive", ui-rounded, "SF Pro Rounded", system-ui, sans-serif;
    --font-mono: "Recursive", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    --step-0: 1.0625rem;
    --step-1: 1.25rem;
    --step-2: 1.6rem;
    --step-3: clamp(2.2rem, 1.4rem + 3.4vw, 3.6rem);
    --section-gap: clamp(3rem, 7vw, 5.5rem);
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --lichen: #1a1612;
      --bark: #ede6d8;
      --fur: #a89f90;
      --moss: #9cc77a;
      --rule: #3a332a;
      --on-moss: #1a1612;
      --term-bg: #110e0b;
      --term-fg: #efe7d8;
      --term-dim: #968b78;
      --term-moss: #b9d39a;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --lichen: #1a1612;
    --bark: #ede6d8;
    --fur: #a89f90;
    --moss: #9cc77a;
    --rule: #3a332a;
    --on-moss: #1a1612;
    --term-bg: #110e0b;
    --term-fg: #efe7d8;
    --term-dim: #968b78;
    --term-moss: #b9d39a;
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--lichen);
    color: var(--bark);
    font-family: var(--font);
    font-variation-settings: "CASL" 0, "MONO" 0;
    font-size: var(--step-0);
    line-height: 1.6;
  }
  .page {
    max-width: 70rem;
    margin: 0 auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    padding-block: max(1.25rem, env(safe-area-inset-top)) max(3rem, env(safe-area-inset-bottom));
    display: grid;
    gap: var(--section-gap);
  }
  main { display: grid; gap: var(--section-gap); min-width: 0; }
  a { color: var(--moss); text-underline-offset: 0.18em; }
  code { font-family: var(--font-mono); font-variation-settings: "MONO" 1, "CASL" 0; font-size: 0.9em; }
  a:focus-visible { outline: 2px solid var(--moss); outline-offset: 3px; border-radius: 4px; }

  header.top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.75rem 1.5rem; }
  .wordmark {
    font-variation-settings: "CASL" 1, "MONO" 0;
    font-weight: 820;
    font-size: var(--step-1);
    color: var(--bark);
    text-decoration: none;
  }
  header.top nav, footer nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.95rem; }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .pitch { min-width: 0; }
  .hero h1 {
    font-variation-settings: "CASL" 1, "MONO" 0;
    font-weight: 880;
    font-size: var(--step-3);
    line-height: 1.04;
    letter-spacing: -0.012em;
    margin: 0 0 1.25rem;
    text-wrap: balance;
  }
  .hero p { margin: 0 0 1.75rem; max-width: 34rem; color: var(--fur); font-size: var(--step-1); line-height: 1.5; text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .button {
    display: inline-block;
    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    font-weight: 650;
    text-decoration: none;
    border: 2px solid var(--moss);
    transition: transform 160ms var(--ease-out), background-color 200ms ease, color 200ms ease;
  }
  .button:active { transform: scale(0.97); }
  .button:focus-visible { outline: 2px solid var(--moss); outline-offset: 3px; }
  .button.primary { background: var(--moss); color: var(--on-moss); }
  .button.secondary { color: var(--moss); }
  @media (hover: hover) and (pointer: fine) {
    .button.secondary:hover { background: color-mix(in oklab, var(--moss) 12%, transparent); }
    .button.primary:hover { background: color-mix(in oklab, var(--moss) 88%, var(--bark)); }
  }

  .terminal {
    margin: 0;
    min-width: 0;
    background: var(--term-bg);
    color: var(--term-fg);
    border-radius: 16px;
    padding: 1.25rem 1.35rem 1.4rem;
    overflow-x: auto;
  }
  .session {
    font-family: var(--font-mono);
    font-variation-settings: "MONO" 1, "CASL" 0;
    font-size: 0.86rem;
    line-height: 1.7;

  }
  /* Long lines wrap as a terminal wraps them, continuing under the text rather than the prompt. */
  .session .line {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding-left: 2ch;
    text-indent: -2ch;
    transition: opacity 240ms var(--ease-out), transform 240ms var(--ease-out);
  }
  .session .line.waiting { opacity: 0; transform: translateY(4px); }
  .session .prompt, .session .you { color: var(--term-moss); }
  .session .dim { color: var(--term-dim); }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--term-moss);
    animation: blink 2.4s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
    .button { transition: none; }
  }

  h2 {
    font-variation-settings: "CASL" 1, "MONO" 0;
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1.15;
    margin: 0 0 0.5rem;
    text-wrap: balance;
  }
  section > .lead { margin: 0 0 1.75rem; color: var(--fur); max-width: 40rem; }
  h3 { margin: 0; font-size: var(--step-1); font-weight: 720; line-height: 1.3; }

  .places { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.75rem 2.25rem; }
  .places li { border-top: 3px solid var(--bark); padding-top: 1rem; display: grid; gap: 0.5rem; align-content: start; }
  .places p, .facts p { margin: 0; color: var(--fur); text-wrap: pretty; }

  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 3rem; }
  .facts > div { border-top: 1px solid var(--rule); padding-block: 1.1rem; display: grid; gap: 0.35rem; align-content: start; }

  .accounts { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem 3rem; align-items: start; }
  .accounts p { margin: 0; color: var(--fur); max-width: 34rem; }
  .accounts ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.6rem; }
  .accounts li { border-left: 3px solid var(--moss); padding-left: 0.9rem; }

  footer { border-top: 1px solid var(--rule); padding-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; justify-content: space-between; color: var(--fur); font-size: 0.95rem; }
  footer p { margin: 0; max-width: 36rem; }

  @media (max-width: 860px) {
    .hero, .accounts { grid-template-columns: minmax(0, 1fr); }
    .places, .facts { grid-template-columns: minmax(0, 1fr); }
  }
</style>
