---
// The landing page: one sentence, a few lines, and the brand's one color, algae green. Its words
// claim only what AiSloth does today; the terminal replays real sloth commands and their output,
// with an example repository.
const repository = "https://github.com/bagatka/ai-sloth";
const install = "curl -fsSL https://aisloth.dev/install.sh | sh";

// The GitHub and X marks, from Simple Icons (CC0).
const githubMark = "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
const xMark = "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z";

type Line =
  | { kind: "command" | "output" | "left"; text: string }
  | { kind: "pushed"; text: string; url: string };

const session: Line[] = [
  { kind: "command", text: 'sloth chat "Fix the flaky checkout test" --repo shop' },
  { kind: "output", text: "Chat 4f2a91 · Claude Code · anthropic · cloud · shop" },
  { kind: "left", text: "^C Left the chat; the agent keeps working." },
  { kind: "command", text: 'sloth chat "Add dark mode" --repo shop --harness codex' },
  { kind: "output", text: "Chat 8c03d7 · Codex · openai · cloud · shop" },
  { kind: "left", text: "^C Left the chat; the agent keeps working." },
  { kind: "command", text: "sloth chat push 4f2a91 --pr" },
  { kind: "pushed", text: "shop: 2 commits on aisloth/4f2a91  ", url: "https://github.com/you/shop/pull/41" },
  { kind: "command", text: "sloth chat push 8c03d7 --pr" },
  { kind: "pushed", text: "shop: 4 commits on aisloth/8c03d7  ", url: "https://github.com/you/shop/pull/42" },
];

// The panel's pattern, small rounded squares in four strengths of white over the green: many
// computers. Drawn at build time from a fixed seed, so every build draws the same one; it is cut to
// the panel's shape, so it fills any size.
const width = 640;
const height = 960;
const svg = (body: string) => `<svg viewBox="0 0 ${width} ${height}" preserveAspectRatio="xMidYMid slice">${body}</svg>`;
function random(seed: number): () => number {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function tiles(): string {
  const next = random(11);
  const strengths = [0.05, 0.1, 0.17, 0.3];
  const groups: string[] = strengths.map(() => "");
  for (let y = 3; y < height; y += 32) {
    for (let x = 3; x < width; x += 32) {
      const roll = next();
      const strength = roll < 0.55 ? 0 : roll < 0.82 ? 1 : roll < 0.95 ? 2 : 3;
      groups[strength] += `<use href="#tile" x="${x}" y="${y}"/>`;
    }
  }
  return svg(`<defs><rect id="tile" width="26" height="26" rx="6"/></defs>` + groups.map((uses, i) => `<g fill="#fff" fill-opacity="${strengths[i]}">${uses}</g>`).join(""));
}

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>AiSloth</title>
    <meta name="description" content="Every coding agent gets its own computer, ready in seconds. Claude Code, Codex, GitHub Copilot and pi, in our cloud or on your own machines. Early beta, open source." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f4f4f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111210" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <div class="page">
      <div class="text">
        <header>
          <button class="name" type="button" aria-label="AiSloth">
            <span aria-hidden="true">Ai<span class="slop">Slop<svg viewBox="0 0 48 10" preserveAspectRatio="none"><path d="M1 6.5C10 3.5 18 8 26 5.2S40 3.6 47 3.8" pathLength="1" /></svg></span><span class="sloth">Sloth<svg viewBox="0 0 48 10" preserveAspectRatio="none"><path d="M1 4.2C12 6.6 21 3.2 30 5.4S42 6.2 47 4.4" pathLength="1" /></svg></span></span>
          </button>
          <nav aria-label="AiSloth elsewhere">
            <a href={repository} aria-label="AiSloth on GitHub" title="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={githubMark} /></svg></a>
            <a href="https://x.com/AiSlothDev" aria-label="AiSloth on X, @AiSlothDev" title="@AiSlothDev"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={xMark} /></svg></a>
          </nav>
        </header>
        <main>
          <h1>Every coding agent gets <em>its own computer.</em></h1>
          <p>
            Start as many agents as you need, each on a computer of its own, ready in seconds. They keep
            working while your laptop sleeps. Claude Code, Codex, GitHub Copilot and pi run natively with
            your own accounts, in our cloud or on your own machines.
          </p>
          <div class="install">
            <code id="install">{install}</code>
            <button type="button" id="copy">Copy</button>
          </div>
          <p class="beta"><span class="dot" aria-hidden="true"></span>Early beta, starting today. For Linux and Macs with Apple silicon; on Windows, in WSL.</p>
        </main>
        <footer>
          <span>Open source, built by Aleksandr Bagatka</span>
          <nav aria-label="Aleksandr Bagatka elsewhere">
            <a href="https://github.com/bagatka" aria-label="Aleksandr Bagatka on GitHub" title="bagatka"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={githubMark} /></svg></a>
            <a href="https://x.com/alex_bagatka" aria-label="Aleksandr Bagatka on X, @alex_bagatka" title="@alex_bagatka"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={xMark} /></svg></a>
          </nav>
        </footer>
      </div>
      <aside class="algae">
        <div class="pattern" aria-hidden="true" set:html={tiles()} />
        <figure class="terminal" aria-label="Two agents started in the cloud with sloth, then each pushed as a pull request">
          <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span>~/shop</span></div>
          <pre><code>{session.map((line) =>
            line.kind === "command" ? <span class="line command"><span class="prompt">$ </span><span class="typed">{line.text.split(" ").map((word, i) => <>{i > 0 && " "}<span class="w">{word}</span></>)}</span></span>
            : line.kind === "pushed" ? <span class="line pushed">{line.text}<span class="url">{line.url}</span></span>
            : <span class={`line ${line.kind}`}>{line.text}</span>
          )}<span class="line command end"><span class="prompt">$ </span><span class="typed"></span></span></code></pre>
        </figure>
      </aside>
    </div>

    <script is:inline>
      const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Copies the install command; where the page may not write the clipboard, selects it instead.
      const copy = document.getElementById("copy");
      copy.addEventListener("click", async () => {
        const command = document.getElementById("install");
        try {
          await navigator.clipboard.writeText(command.textContent);
          copy.textContent = "Copied";
          setTimeout(() => (copy.textContent = "Copy"), 1600);
        } catch {
          getSelection().selectAllChildren(command);
        }
      });

      const terminal = document.querySelector(".terminal");
      const code = terminal.querySelector("code");
      const session = code.innerHTML;

      // The name's easter egg: a click turns the page into AI slop, the name AiSlop with Sloth struck
      // out, until the next click, when the pen strikes the slop out and AiSloth comes back.
      const slop = {
        title: "AiSlop — Revolutionize Your Workflow with AI ✨",
        heading: "Unlock the Power of Seamless, AI-Driven Synergy ✨",
        text: "In today’s fast-paced world, it’s not just about coding — it’s about elevating your workflow to the next level. 🚀 Delve into a rich tapestry of cutting-edge, robust, AI-powered solutions that empower you to navigate the ever-evolving landscape of software development — seamlessly.",
        badge: "✨ Introducing AiSlop 2.0 — now with AGI",
        start: "🚀 Get Started — It’s Free!",
        beta: "✨ Trusted by 10,000+ forward-thinking developers worldwide — and counting.",
        footer: "© 2026 AiSlop Inc. — Made with ❤️ and AI.",
        bar: "✨ AI Terminal Pro",
        terminal: [
          "$ npx create-ai-slop@latest --yes",
          "✨ Leveraging cutting-edge AI…",
          "🔍 Delving into your codebase…",
          "🧠 Synthesizing a holistic strategy…",
          "🚀 Unlocking 10x productivity…",
          "✅ Done! Your code is now 100% more synergistic.",
          "💡 Remember: it’s not just code — it’s a journey.",
        ],
      };
      const heading = document.querySelector("main h1");
      const text = document.querySelector("main > p");
      const beta = document.querySelector(".beta");
      const footer = document.querySelector("footer > span");
      const bar = terminal.querySelector(".bar span");
      const install = document.querySelector(".install");
      const real = { title: document.title, heading: heading.innerHTML, text: text.innerHTML, beta: beta.innerHTML, footer: footer.textContent, bar: bar.textContent };
      const start = document.createElement("button");
      start.type = "button";
      start.className = "slop-start";
      start.textContent = slop.start;
      const badge = document.createElement("span");
      badge.className = "slop-badge";
      badge.textContent = slop.badge;
      // The slop goes away by itself after 10 seconds, or when the name or its own Get Started button
      // is clicked.
      let slopped = false;
      let busy = false;
      let back = 0;
      document.querySelector(".name").addEventListener("click", flip);
      start.addEventListener("click", flip);

      async function flip() {
        if (busy) {
          return;
        }
        busy = true;
        clearTimeout(back);
        slopped = !slopped;
        if (slopped) {
          await toSlop();
          back = setTimeout(flip, 10000);
        } else {
          await toSloth();
        }
        busy = false;
      }

      async function toSlop() {
        const heard = struckOut("");
        const words = document.createElement("span");
        words.className = "slop-words";
        heard.append(words);
        const said = struckOut("");
        await crossfade(() => {
          document.documentElement.classList.add("slopped");
          document.title = slop.title;
          bar.textContent = slop.bar;
          footer.textContent = slop.footer;
          install.after(start);
          heading.before(badge);
          beta.replaceChildren(struckOut(slop.beta));
          code.replaceChildren();
          heading.replaceChildren(heard);
          text.replaceChildren(said);
        });
        typeSlop();
        await stream(words, slop.heading);
        await stream(said, slop.text);
      }

      async function toSloth() {
        for (const line of document.querySelectorAll(".slop-strike")) {
          line.classList.add("struck");
        }
        await pause(still ? 0 : 1000);
        await crossfade(() => {
          document.documentElement.classList.remove("slopped");
          document.title = real.title;
          heading.innerHTML = real.heading;
          text.innerHTML = real.text;
          beta.innerHTML = real.beta;
          footer.textContent = real.footer;
          bar.textContent = real.bar;
          start.remove();
          badge.remove();
          code.innerHTML = session;
          for (const line of code.querySelectorAll(".line")) {
            line.classList.add("shown");
          }
          code.querySelector(".end").classList.add("typing");
        });
      }

      // Changes the page in one step that the browser crossfades, or a plain fade where it can't.
      async function crossfade(change) {
        if (still) {
          change();
          return;
        }
        if (document.startViewTransition) {
          await document.startViewTransition(change).finished;
          return;
        }
        const page = document.querySelector(".page");
        const out = page.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 250, fill: "forwards" });
        await out.finished;
        change();
        await page.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 450, easing: "ease-out" }).finished;
        out.cancel();
      }

      // A span the pen can strike out when AiSloth comes back.
      function struckOut(words) {
        const span = document.createElement("span");
        span.className = "slop-strike";
        span.textContent = words;
        return span;
      }

      // Writes text a word at a time, as a chatbot streams its answer.
      async function stream(element, words) {
        const cursor = document.createElement("span");
        cursor.className = "slop-cursor";
        cursor.textContent = "▍";
        const all = words.split(" ");
        for (let i = 1; i <= all.length; i++) {
          element.textContent = all.slice(0, i).join(" ") + " ";
          element.append(cursor);
          await pause(still ? 0 : 35 + Math.random() * 45);
        }
        cursor.remove();
      }

      async function typeSlop() {
        for (const [i, words] of slop.terminal.entries()) {
          if (!slopped) {
            return;
          }
          const line = document.createElement("span");
          line.className = i === 0 ? "line shown command" : "line shown output";
          line.textContent = words;
          code.append(line);
          await pause(still ? 0 : i === 0 ? 700 : 450);
        }
      }

      // Replays the session once: commands type out, their output follows. Hidden lines keep their
      // space, so nothing around the terminal moves. Each word of a command stays whole when the line
      // wraps, so a flag like --repo never breaks after its dashes.
      if (!still) {
        terminal.classList.add("playing");
        play();
      }

      // Shows the first `count` characters of the words.
      function show(typed, words, count) {
        typed.replaceChildren();
        for (const word of words) {
          if (count <= 0) {
            break;
          }
          if (typed.childElementCount > 0) {
            typed.append(" ");
            count--;
          }
          const part = document.createElement("span");
          part.className = "w";
          part.textContent = word.slice(0, count);
          count -= word.length;
          typed.append(part);
        }
      }

      async function play() {
        await pause(500);
        for (const line of terminal.querySelectorAll(".line")) {
          const typed = line.querySelector(".typed");
          if (typed) {
            const words = [...typed.querySelectorAll(".w")].map((word) => word.textContent);
            const length = words.join(" ").length;
            show(typed, words, 0);
            line.classList.add("shown", "typing");
            await pause(400);
            for (let i = 1; i <= length; i++) {
              show(typed, words, i);
              await pause(22 + Math.random() * 28);
            }
            if (!line.classList.contains("end")) {
              line.classList.remove("typing");
            }
            await pause(300);
          } else {
            line.classList.add("shown");
            await pause(line.classList.contains("left") ? 900 : 500);
          }
        }
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Hanken Grotesk";
    src: url("/fonts/hanken-grotesk-latin.woff2") format("woff2");
    font-weight: 400 800;
    font-display: swap;
  }
  @font-face {
    font-family: "JetBrains Mono";
    src: url("/fonts/jetbrains-mono-latin.woff2") format("woff2");
    font-weight: 400 700;
    font-display: swap;
  }

  /* Algae is the brand's one color. --algae is the tone for text and buttons on each ground, at
     least 4.5:1 against it; the panel shows the whole range. */
  :root {
    --ground: #f4f4f1;
    --ink: #161715;
    --soft: #5b5d57;
    --line: #dcddd7;
    --algae: #3f7d20;
    --pen: #3f7d20;
    --slop: #9333ea;
    --on-algae: #ffffff;
    --panel: linear-gradient(180deg, #d3e9a8 0%, #8fc25a 42%, #4f8d2b 72%, #2f6316 100%);
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #111210;
      --ink: #ecede8;
      --soft: #a2a49d;
      --line: #2a2c28;
      --algae: #9ccf6a;
      --pen: #9ccf6a;
      --slop: #c084fc;
      --on-algae: #10140f;
      --panel: linear-gradient(180deg, #b7da8b 0%, #78b246 42%, #427f22 72%, #24510f 100%);
    }
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: "Hanken Grotesk", system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  a { color: inherit; }
  a:focus-visible { outline: 2px solid var(--algae); outline-offset: 3px; border-radius: 4px; }

  .page {
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
    padding: 12px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding: 2.25rem clamp(1rem, 4vw, 3.25rem);
  }
  header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  header a { text-decoration: none; color: var(--soft); }
  header a:hover { color: var(--ink); }
  /* Where else AiSloth and its author are: logos only, the same in the header and the footer. */
  header nav, footer nav { display: flex; align-items: center; gap: 1rem; }
  header nav a, footer nav a { display: inline-flex; padding: 0.25rem; margin: -0.25rem; color: var(--soft); }
  header nav a:hover, footer nav a:hover { color: var(--ink); }
  header nav svg { width: 1.25rem; height: 1.25rem; fill: currentColor; }
  footer nav svg { width: 1.05rem; height: 1.05rem; fill: currentColor; }
  header .name {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: 700 1.25rem/1.6 "Hanken Grotesk", system-ui, sans-serif;
    letter-spacing: -0.02em;
    cursor: pointer;
  }
  header .name:focus-visible { outline: 2px solid var(--algae); outline-offset: 4px; border-radius: 4px; }

  /* The name strikes itself out: AiSlop becomes AiSloth. On load the line draws through "Slop" and
     "Sloth" arrives; without motion, it shows the end. */
  .slop { position: relative; display: inline-block; color: var(--soft); font-weight: 600; margin-right: 0.18em; animation: dim 300ms 700ms both; }
  .slop path { fill: none; stroke: var(--algae); stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: strike 420ms 700ms cubic-bezier(0.6, 0, 0.25, 1) forwards; }
  .sloth { position: relative; display: inline-block; animation: arrive 380ms 1050ms cubic-bezier(0.2, 0.8, 0.2, 1) both; transition: color 300ms ease; }
  .slop svg, .sloth svg { position: absolute; left: -2%; top: 50%; width: 106%; height: 0.5em; transform: translateY(-38%); overflow: visible; }
  .sloth path { fill: none; stroke: var(--slop); stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 420ms cubic-bezier(0.6, 0, 0.25, 1); }
  @keyframes dim { from { color: var(--ink); font-weight: 700; } }
  @keyframes strike { to { stroke-dashoffset: 0; } }
  @keyframes arrive { from { opacity: 0; transform: translateY(0.3em); } }
  @media (prefers-reduced-motion: reduce) {
    .slop, .sloth { animation: none; }
    .slop path { animation: none; stroke-dashoffset: 0; }
    .slopped .slop path { stroke-dashoffset: 1; }
    .sloth path, .slop-strike { transition: none; }
  }

  main { margin-block: auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; max-width: 36rem; }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 1.3rem + 1.5vw, 2.4rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  h1 em { font-style: normal; color: var(--algae); }
  main p { margin: 0; color: var(--soft); max-width: 33rem; }

  .install {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding: 0.45rem 0.45rem 0.45rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .install code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    font: 0.9rem/1.6 "JetBrains Mono", ui-monospace, monospace;
  }
  .install code::before { content: "$ "; color: var(--algae); user-select: none; }
  .install button {
    flex: none;
    padding: 0.55rem 1rem;
    border: 0;
    border-radius: 10px;
    background: var(--algae);
    color: var(--on-algae);
    font: 600 0.92rem "Hanken Grotesk", system-ui, sans-serif;
    cursor: pointer;
    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .install button:active { transform: scale(0.97); }
  .install button:focus-visible { outline: 2px solid var(--algae); outline-offset: 3px; }
  .beta { display: flex; align-items: baseline; gap: 0.6rem; margin: 0; color: var(--soft); font-size: 0.95rem; }
  .dot { width: 0.5rem; height: 0.5rem; flex: none; border-radius: 50%; background: var(--algae); transform: translateY(-0.05em); }

  footer { display: flex; flex-wrap: wrap; align-items: center; column-gap: 0.9rem; row-gap: 0.3rem; color: var(--soft); font-size: 0.95rem; }

  .algae {
    position: sticky;
    top: 12px;
    height: calc(100dvh - 24px);
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border-radius: 18px;
    overflow: hidden;
    isolation: isolate;
    background: var(--panel);
  }
  /* A fine grain, so the panel reads as a surface rather than a flat fill. */
  .algae::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.22;
    mix-blend-mode: soft-light;
